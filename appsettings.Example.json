    "BaseUrl": "https://ummahapi.com",
    "ApiKey": "YOUR_UMMAHAPI_KEY_HERE"
  },
  "Apns": {
    "TeamId": "YOUR_APPLE_TEAM_ID",
    "KeyId": "YOUR_APNS_KEY_ID",
    "BundleId": "com.yourcompany.yourapp",
    "PrivateKeyPath": "/path/to/AuthKey_YOUR_APNS_KEY_ID.p8",
    "PrivateKey": ""
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT_REF.supabase.co",
    "JwtSecret": "OPTIONAL — only for legacy HS256 JWT secret (not sb_secret_* API keys). JWKS is used when omitted.",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY — must be from the same project as Url (Settings → API → service_role). Required for account deletion."
